me:'New tab',url:null}];select(0);$('dashboard').hidden=true;$('welcome').hidden=false;$('username').value='';$('menu').hidden=true};$('date').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long',month:'long',day:'numeric'}).format(new Date());drawGrid(apps,'schoolGrid');drawGrid(extras,'extraGrid');if(safeRead('orbit-theme')==='light')document.body.classList.add('light');if(safeRead('orbit-name'))enter(safeRead('orbit-name'));
</script></html>
