function updateName(){ $('greeting').textContent='Hi, '+username; $('headline').textContent='Hi, '+username;}function enter(name){username=name.trim()||'Explorer';safeWrite('orbit-name',username);updateName();$('welcome').hidden=true;$('dashboard').hidden=false;drawTabs()}$('login').onsubmit=e=>{e.preventDefault();enter($('username').value)};
let appPrefs={};try{appPrefs=JSON.parse(safeRead('orbit-app-layout')||'{}')}catch{}
function saveApps(){safeWrite('orbit-app-layout',JSON.stringify(appPrefs));drawGrid(apps,'schoolGrid');drawGrid(extras,'extraGrid')}
let openAppMenu=null;
document.addEventListener('click',()=>{if(openAppMenu){openAppMenu.remove();openAppMenu=null}});
function drawGrid(list,target,q=''){
 const grid=$(target);grid.replaceChildren();const ordered=[...list].sort((a,b)=>(appPrefs[a[0]]?.order??list.indexOf(a))-(appPrefs[b[0]]?.order??list.indexOf(b)));
 const visible=ordered.filter(a=>!appPrefs[a[0]]?.removed&&a[0].toLowerCase().includes(q.toLowerCase()));
 const folders=new Map();
 function addApp(app,container){
  const wrap=document.createElement('div');wrap.className='app-wrap';
  const button=document.createElement(target==='schoolGrid'?'a':'button');button.className='app';if(target==='schoolGrid'){button.href=app[2];button.target='_blank';button.rel='noopener noreferrer';}
  const icon=document.createElement('span');icon.className='appicon uploaded-icon';const img=document.createElement('img');img.src='/personal-assets/'+appImages[app[0]];img.alt='';icon.append(img);
  const label=document.createElement('span');label.className='appname';label.textContent=app[0];button.append(icon,label);if(target!=='schoolGrid')button.onclick=()=>openTab(app[0],app[2]);
  const dots=document.createElement('button');dots.className='app-dots';dots.textContent='⋮';dots.setAttribute('aria-label','Options for '+app[0]);dots.setAttribute('aria-haspopup','menu');
  dots.onclick=e=>{e.stopPropagation();if(openAppMenu)openAppMenu.remove();const menu=document.createElement('div');menu.className='app-menu';menu.setAttribute('role','menu');openAppMenu=menu;
   const pref=()=>appPrefs[app[0]]??={};
   const add=(name,fn,disabled=false)=>{const b=document.createElement('button');b.textContent=name;b.setAttribute('role','menuitem');b.disabled=disabled;b.onclick=e=>{e.stopPropagation();menu.remove();openAppMenu=null;fn()};menu.append(b)};
   add('Remove from Home',()=>{pref().removed=true;saveApps()});
   const folderNames=[...new Set(Object.values(appPrefs).map(p=>p.folder).filter(Boolean))];
   add('Move to Existing Folder',()=>chooseFolder(app,folderNames),!folderNames.length);
   const swap=dir=>{const i=ordered.indexOf(app),j=i+dir;if(j<0||j>=ordered.length)return;ordered.forEach((a,k)=>{(appPrefs[a[0]]??={}).order=k});appPrefs[app[0]].order=j;appPrefs[ordered[j][0]].order=i;saveApps()};
   add('Move Left',()=>swap(-1),ordered.indexOf(app)===0);add('Move Right',()=>swap(1),ordered.indexOf(app)===ordered.length-1);
   add('Move to New Folder',()=>chooseFolder(app,null));if(pref().folder)add('Move back to Home',()=>{delete pref().folder;saveApps()});
   wrap.append(menu);
  };
  wrap.append(button,dots);container.append(wrap);
 }
 for(const app of visible){const folder=appPrefs[app[0]]?.folder;if(folder){if(!folders.has(folder))folders.set(folder,[]);folders.get(folder).push(app)}else addApp(app,grid)}
 for(const [name,items] of folders){const details=document.createElement('details');details.className='app-folder';const summary=document.createElement('summary');summary.textContent='▣ '+name+' ('+items.length+')';const inner=document.createElement('div');inner.className='grid';items.forEach(a=>addApp(a,inner));details.append(summary,inner);grid.append(details)}
}
function chooseFolder(app,names){modal(names?'Choose folder':'New folder');const control=document.createElement(names?'select':'input');control.setAttribute('aria-label','Folder name');if(names){for(const name of names){const option=document.createElement('option');option.value=name;option.textContent=name;control.append(option)}}else{control.placeholder='Folder name';control.maxLength=40}const save=document.createElement('button');save.className='primary';save.textContent='Move app';save.onclick=()=>{const name=control.value.trim();if(!name)return;(appPrefs[app[0]]??={}).folder=name;saveApps();$('dialog').close()};$('dialogBody').append(control,save)}
function drawTabs(){ $('tabs').replaceChildren();for(const t of tabs){const wrap=document.createElement('div');wrap.className='tab'+(active===t.id?' active':'');const b=document.createElement('button');b.textContent=t.name;b.onclick=()=>select(t.id);wrap.append(b);if(t.id){const x=document.createElement('button');x.textContent='×';x.setAttribute('aria-label','Close '+t.name);x.onclick=()=>{document.getElementById('workspace-frame-'+t.id)?.remove();tabs=tabs.filter(a=>a.id!==t.id);if(active===t.id)select(0);else drawTabs()};wrap.append(x)}if(t.id===active)wrap.classList.add('tab-enter');$('tabs').append(wrap)}const plus=document.createElement('button');plus.className='icon';plus.textContent='+';plus.setAttribute('aria-label','New dashboard tab');plus.onclick=()=>openTab('New tab',null);$('tabs').append(plus)}
function openTab(name,url){const t={id:next++,name,url};tabs.push(t);select(t.id)}let registrationPromise;
async function prepareProxy(){
 if(!window.isSecureContext || !('serviceWorker' in navigator))throw new Error('Shuttle requires HTTPS (or localhost) and a browser that supports service workers.');
 if(!window.__uv$config || !window.Ultraviolet)throw new Error('Ultraviolet assets did not load. Run npm install on the server, then restart Shuttle.');
 if(!registrationPromise)registrationPromise=navigator.serviceWorker.register('/uv.sw-handler.js',{scope:__uv$config.prefix}).then(reg=>new Promise((resolve,reject)=>{
  if(reg.active)return resolve(reg);
  const worker=reg.installing||reg.waiting;
  if(!worker)return reject(new Error('No Ultraviolet service worker was created.'));
  worker.addEventListener('statechange',()=>{if(worker.state==='activated')resolve(reg);if(worker.state==='redundant')reject(new Error('Ultraviolet service worker installation failed.'))});
  if(worker.state==='activated')resolve(reg);
 })).catch(err=>{registrationPromise=null;throw err});
 return registrationPromise;
}
const authHosts=/google\.com$|skyward\.iscorp\.com$|clever\.com$|sharepoint\.com$|microsoftonline\.com$|kahoot\.it$|edmentum\.com$|schoolobjects\.com$|soraapp\.com$/;
function setStatus(message){$('proxyStatus').textContent=message}
function select(id){
 active=id;const t=tabs.find(t=>t.id===id);document.body.classList.toggle('app-view',!!t.url);$('home').hidden=!!t.url;$('web').hidden=!t.url;
 for(const f of $('frameHost').children)f.hidden=true;
 if(t.url){
  $('address').value=t.url;$('webTitle').textContent=t.name;$('official').href=t.url;
  if(authHosts.test(new URL(t.url).hostname)){setStatus('Use “Continue on official site” for this account or school sign-in.');}
  else{
   let f=document.getElementById('workspace-frame-'+id);
   if(f){f.hidden=false;setStatus('Shuttle app tab. If this site does not load, use its official page.');}
   else{
    setStatus('Starting Shuttle connection…');
    prepareProxy().then(()=>{
     if(!tabs.some(x=>x.id===id&&x.url===t.url))return;
     const existing=document.getElementById('workspace-frame-'+id);if(existing){existing.hidden=active!==id;return;}
     f=document.createElement('iframe');f.id='workspace-frame-'+id;f.className='viewer';f.title=t.name;
     f.referrerPolicy='no-referrer';f.setAttribute('sandbox','allow-scripts allow-forms allow-same-origin allow-popups allow-presentation allow-downloads');
     f.src=t.name==='Games' ? '/math' : __uv$config.prefix+__uv$config.encodeUrl(t.url);f.hidden=active!==id;$('frameHost').append(f);
     if(active===id)setStatus('Shuttle app tab. If this site does not load, use its official page.');
    }).catch(err=>{if(active===id)setStatus(err.message)});
   }
  }
 }
 drawTabs();
}
